{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Calibri, 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 10,
      "labelColor": "#666",
      "titleFontSize": 10,
      "titleColor": "#888",
      "titleFontWeight": "normal",
      "domain": false,
      "ticks": false,
      "gridColor": "#f0f0f0",
      "labelPadding": 6
    },
    "axisX": {
      "grid": false
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "title": null,
      "labelFontSize": 10,
      "labelColor": "#555",
      "symbolType": "square",
      "symbolSize": 70,
      "columnPadding": 14
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "text": {
      "font": "Calibri, 'Segoe UI', Arial, sans-serif"
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "balance",
          "as": "_tot"
        }
      ]
    },
    {
      "calculate": "datum.balance / datum._tot",
      "as": "_share"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": {
          "expr": "min(width, height) * 0.30"
        },
        "outerRadius": {
          "expr": "min(width, height) * 0.42"
        },
        "tooltip": true
      },
      "encoding": {
        "theta": {
          "field": "balance",
          "type": "quantitative",
          "stack": true
        },
        "color": {
          "field": "region",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "North",
              "Central",
              "South 1",
              "South 2",
              "South 3",
              "North 1",
              "North 2",
              "Others"
            ],
            "range": [
              "#4472c4",
              "#bf9000",
              "#2f5597",
              "#70ad47",
              "#c55a11",
              "#4472c4",
              "#5b9bd5",
              "#9e9e9e"
            ]
          },
          "legend": {
            "orient": "bottom",
            "columns": 2,
            "labelLimit": 120
          }
        },
        "order": {
          "field": "region",
          "sort": "ascending"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.region == 'North'"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#4472c4"
      },
      "encoding": {
        "text": {
          "field": "_share",
          "format": ".1%"
        }
      }
    }
  ]
}
