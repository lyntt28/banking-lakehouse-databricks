{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": "container",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "font": "Calibri, 'Segoe UI', Arial, sans-serif",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 10,
      "labelColor": "#666",
      "titleFontSize": 10,
      "titleColor": "#888",
      "titleFontWeight": "normal",
      "domain": false,
      "ticks": false,
      "gridColor": "#f0f0f0",
      "labelPadding": 6
    },
    "axisX": {
      "grid": false
    },
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "title": null,
      "labelFontSize": 10,
      "labelColor": "#555",
      "symbolType": "square",
      "symbolSize": 70,
      "columnPadding": 14
    },
    "bar": {
      "cornerRadiusEnd": 2
    },
    "text": {
      "font": "Calibri, 'Segoe UI', Arial, sans-serif"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "month",
          "type": "ordinal",
          "title": null,
          "sort": null,
          "axis": {
            "labelAngle": 0,
            "labelLimit": 140
          }
        },
        "y": {
          "field": "overdue_k_usd",
          "type": "quantitative",
          "aggregate": "sum",
          "title": "Overdue Amount (1000 USD)",
          "stack": "zero"
        },
        "color": {
          "field": "del_grp",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "1-10",
              "11-90",
              "91-180",
              "181-360",
              "361+"
            ],
            "range": [
              "#f3e3b0",
              "#e2c66b",
              "#bf9000",
              "#c55a11",
              "#843c0c"
            ]
          }
        }
      }
    }
  ]
}
