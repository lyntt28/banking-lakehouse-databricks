{
  "datasets": [
    {
      "name": "ops_kpi",
      "displayName": "Current state",
      "queryLines": [
        "WITH pub AS (SELECT max(as_of_date) AS d FROM ops.published_batches),\n",
        "last_run AS (SELECT * FROM (SELECT *, row_number() OVER (PARTITION BY as_of_date, layer\n",
        "                                        ORDER BY started_at DESC, status DESC) AS rn\n",
        "                             FROM ops.pipeline_runs) WHERE rn = 1)\n",
        "SELECT pub.d AS serving_batch,\n",
        "       datediff(current_date(), pub.d) AS serving_age_days,\n",
        "       (SELECT count(*) FROM last_run WHERE status = 'FAILED') AS open_failures,\n",
        "       (SELECT round(avg(CASE WHEN status = 'SUCCESS' THEN 100.0 ELSE 0 END), 1)\n",
        "        FROM ops.pipeline_runs WHERE status <> 'RUNNING'\n",
        "          AND started_at >= current_timestamp() - INTERVAL 30 DAYS) AS success_rate_30d\n",
        "FROM pub\n"
      ],
      "parameters": []
    },
    {
      "name": "ops_status",
      "displayName": "Batch status (last 14 days)",
      "queryLines": [
        "SELECT as_of_date, layer, status, run_id, started_at, finished_at, message\n",
        "FROM (SELECT *, row_number() OVER (PARTITION BY as_of_date, layer\n",
        "                                   ORDER BY started_at DESC, status DESC) AS rn\n",
        "      FROM ops.pipeline_runs WHERE as_of_date >= date_sub(current_date(), 14))\n",
        "WHERE rn = 1\n",
        "ORDER BY as_of_date DESC, layer\n"
      ],
      "parameters": []
    },
    {
      "name": "ops_steps",
      "displayName": "Failed steps",
      "queryLines": [
        "SELECT logged_at, as_of_date, layer, step, rows_in, rows_out, duration_s, error, run_id\n",
        "FROM ops.task_runs WHERE status = 'FAILED' ORDER BY logged_at DESC LIMIT 50\n"
      ],
      "parameters": []
    },
    {
      "name": "ops_duration",
      "displayName": "Processing time per day (minutes)",
      "queryLines": [
        "SELECT date_format(as_of_date, 'yyyy-MM-dd') AS day, layer, sum(duration_s) / 60 AS minutes\n",
        "FROM ops.task_runs WHERE status = 'SUCCESS' AND as_of_date >= date_sub(current_date(), 30)\n",
        "GROUP BY 1, 2\n"
      ],
      "parameters": []
    },
    {
      "name": "ops_files",
      "displayName": "Source files not normal",
      "queryLines": [
        "SELECT as_of_date, table_name, status, file_count, rows, first_loaded_at\n",
        "FROM ops.file_manifest\n",
        "WHERE status IN ('MISSING', 'INCOMPLETE', 'MULTIPLE_FILES')\n",
        "  AND as_of_date >= date_sub(current_date(), 14)\n",
        "ORDER BY as_of_date DESC, table_name\n"
      ],
      "parameters": []
    },
    {
      "name": "ops_dq",
      "displayName": "DQ failed rows per day",
      "queryLines": [
        "SELECT date_format(run_ts, 'yyyy-MM-dd') AS day, severity, sum(failed_rows) AS failed_rows\n",
        "FROM ops.dq_results WHERE run_ts >= current_timestamp() - INTERVAL 30 DAYS AND failed_rows > 0\n",
        "GROUP BY 1, 2\n"
      ],
      "parameters": []
    },
    {
      "name": "ops_recon",
      "displayName": "Reconciliation issues",
      "queryLines": [
        "SELECT as_of_date, 'card_kpi' AS check, metric_code AS item, status, diff\n",
        "FROM ops.recon_card_kpi WHERE status NOT IN ('MATCH', 'WITHIN_TOLERANCE')\n",
        "UNION ALL\n",
        "SELECT as_of_date, 'deposit', concat_ws('/', account_group, currencycd, branchnbr), status, diff\n",
        "FROM ops.recon_deposit WHERE status <> 'MATCH'\n",
        "ORDER BY as_of_date DESC LIMIT 100\n"
      ],
      "parameters": []
    }
  ],
