{
  "datasets": [
    {
      "name": "ovd_tickers",
      "displayName": "Tickers",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        "SELECT x.ovd / nullif(x.port, 0) * 100 AS overdue_ratio,\n",
        "       x.ovd / p.usd AS overdue_usd, x.port / p.usd AS ending_usd\n",
        "FROM day x, p WHERE x.as_of_date = p.d\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_compare",
      "displayName": "Tickers vs last day / month / year",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        ", pick AS (\n",
        "  SELECT 1 AS ord, 'vs Last Day' AS cmp,\n",
        "         (SELECT max(as_of_date) FROM day, p WHERE as_of_date < p.d) AS dd FROM p\n",
        "  UNION ALL SELECT 2, 'vs Last Month', (SELECT max(as_of_date) FROM day, p\n",
        "         WHERE as_of_date <= last_day(add_months(p.d, -1))) FROM p\n",
        "  UNION ALL SELECT 3, 'vs Last Year', (SELECT max(as_of_date) FROM day, p\n",
        "         WHERE as_of_date <= make_date(year(p.d) - 1, 12, 31)) FROM p),\n",
        "cur AS (SELECT x.* FROM day x, p WHERE x.as_of_date = p.d)\n",
        "SELECT pk.ord, pk.cmp,\n",
        "  (cur.ovd / nullif(cur.port, 0) - c.ovd / nullif(c.port, 0)) * 100 AS ratio_pp,\n",
        "  (cur.ovd - c.ovd) / p.usd AS overdue_usd, (cur.port - c.port) / p.usd AS ending_usd\n",
        "FROM pick pk CROSS JOIN cur CROSS JOIN p LEFT JOIN day c ON c.as_of_date = pk.dd\n",
        "ORDER BY pk.ord\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_last5",
      "displayName": "Overdue Trend (Last 5 Days)",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        "SELECT date_format(x.as_of_date, 'dd/MM') AS day, x.ovd / p.usd / 1000 AS overdue_k_usd,\n",
        "       x.ovd / nullif(x.port, 0) * 100 AS overdue_ratio\n",
        "FROM day x, p WHERE x.as_of_date IN (\n",
        "  SELECT as_of_date FROM day, p WHERE as_of_date <= p.d ORDER BY as_of_date DESC LIMIT 5)\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_monthly",
      "displayName": "Overdue Trend (Monthly)",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        ", m AS (SELECT date_format(as_of_date, 'yyyy-MM') AS month, max(as_of_date) AS last_d\n",
        "        FROM day, p WHERE as_of_date <= p.d GROUP BY 1)\n",
        "SELECT m.month, x.ovd / p.usd / 1000 AS overdue_k_usd,\n",
        "       x.ovd / nullif(x.port, 0) * 100 AS overdue_ratio\n",
        "FROM m JOIN day x ON x.as_of_date = m.last_d CROSS JOIN p\n",
        "WHERE m.month > date_format(add_months(p.d, -6), 'yyyy-MM')\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_debt_groups",
      "displayName": "Overdue Amount by Debt Groups",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        ", m AS (SELECT date_format(as_of_date, 'yyyy-MM') AS month, max(as_of_date) AS last_d\n",
        "        FROM day, p WHERE as_of_date <= p.d GROUP BY 1)\n",
        "SELECT m.month, concat('Group ', f.debt_group) AS debt_group,\n",
        "       sum(f.overdue_balance) / p.usd / 1000 AS overdue_k_usd\n",
        "FROM m JOIN f ON f.as_of_date = m.last_d CROSS JOIN p\n",
        "WHERE f.debt_group >= 2 AND m.month > date_format(add_months(p.d, -6), 'yyyy-MM')\n",
        "GROUP BY m.month, f.debt_group, p.usd\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_product_amount",
      "displayName": "Overdue Amount by Product Groups",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        "SELECT coalesce(f.product_group, 'Other') AS product_group,\n",
        "       sum(f.overdue_balance) / p.usd / 1000 AS overdue_k_usd\n",
        "FROM f, p WHERE f.as_of_date = p.d GROUP BY 1, p.usd\n"
