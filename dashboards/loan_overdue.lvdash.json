{
  "datasets": [
    {
      "name": "ovd_fx",
      "displayName": "FX rate",
      "queryLines": [
        "SELECT (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS fx_vnd_usd\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_tickers",
      "displayName": "Tickers",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.card_mart_overdue_daily WHERE as_of_date <= :report_date) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.card_mart_overdue_daily WHERE :branch = 'all' OR mng_br = :branch),\n",
        "day AS (SELECT as_of_date, sum(ovd_bal) ovd, sum(port_bal) port FROM f GROUP BY as_of_date)\n",
        "\n",
        "SELECT x.ovd / nullif(x.port, 0) * 100 AS overdue_ratio,\n",
        "       x.ovd / p.usd AS overdue_usd, x.port / p.usd AS ending_usd\n",
        "FROM day x, p WHERE x.as_of_date = p.d\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_compare",
      "displayName": "Tickers vs last day / month / year",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.card_mart_overdue_daily WHERE as_of_date <= :report_date) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.card_mart_overdue_daily WHERE :branch = 'all' OR mng_br = :branch),\n",
        "day AS (SELECT as_of_date, sum(ovd_bal) ovd, sum(port_bal) port FROM f GROUP BY as_of_date)\n",
        "\n",
        ", pick AS (\n",
        "  SELECT 1 AS ord, 'vs Last Day' AS cmp,\n",
        "         (SELECT max(as_of_date) FROM day, p WHERE as_of_date <= date_sub(p.d, 1)) AS dd FROM p\n",
        "  UNION ALL SELECT 2, 'vs Last Month', (SELECT max(as_of_date) FROM day, p\n",
        "         WHERE as_of_date <= last_day(add_months(p.d, -1))) FROM p\n",
        "  UNION ALL SELECT 3, 'vs Last Year', (SELECT max(as_of_date) FROM day, p\n",
        "         WHERE as_of_date <= make_date(year(p.d) - 1, 12, 31)) FROM p),\n",
        "cur AS (SELECT x.* FROM day x, p WHERE x.as_of_date = p.d)\n",
        "SELECT pk.ord, pk.cmp, v.ratio_pp, v.overdue_usd, v.ending_usd,\n",
        "  -- như dashboard gốc: ▲ / ▼ / ▪ + trị tuyệt đối (USD làm tròn, % 2 số lẻ)\n",
        "  concat(CASE WHEN v.ratio_pp > 0 THEN '▲ ' WHEN v.ratio_pp < 0 THEN '▼ ' ELSE '▪ ' END,\n",
        "         format_number(abs(v.ratio_pp), 2), '%') AS ratio_txt,\n",
        "  concat(CASE WHEN v.overdue_usd > 0 THEN '▲ ' WHEN v.overdue_usd < 0 THEN '▼ ' ELSE '▪ ' END,\n",
        "         format_number(abs(v.overdue_usd), 0)) AS overdue_txt,\n",
        "  concat(CASE WHEN v.ending_usd > 0 THEN '▲ ' WHEN v.ending_usd < 0 THEN '▼ ' ELSE '▪ ' END,\n",
        "         format_number(abs(v.ending_usd), 0)) AS ending_txt\n",
        "FROM pick pk CROSS JOIN cur CROSS JOIN p LEFT JOIN day c ON c.as_of_date = pk.dd\n",
        "LATERAL VIEW inline(array(struct(\n",
        "  round((cur.ovd / nullif(cur.port, 0) - c.ovd / nullif(c.port, 0)) * 100, 2) AS ratio_pp,\n",
        "  round((cur.ovd - c.ovd) / p.usd, 0) AS overdue_usd,\n",
        "  round((cur.port - c.port) / p.usd, 0) AS ending_usd))) v\n",
        "ORDER BY pk.ord\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_last5",
      "displayName": "Overdue Trend (Last 5 Days)",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.card_mart_overdue_daily WHERE as_of_date <= :report_date) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.card_mart_overdue_daily WHERE :branch = 'all' OR mng_br = :branch),\n",
        "day AS (SELECT as_of_date, sum(ovd_bal) ovd, sum(port_bal) port FROM f GROUP BY as_of_date)\n",
        "\n",
        ", dd AS (SELECT DISTINCT as_of_date FROM gold.card_mart_overdue_daily, p WHERE as_of_date <= p.d\n",
        "         ORDER BY as_of_date DESC LIMIT 5)\n",
        "SELECT date_format(dd.as_of_date, 'MM-dd') AS day,\n",
        "       coalesce(x.ovd, 0) / p.usd / 1000 AS overdue_k_usd,\n",
        "       coalesce(x.ovd / nullif(x.port, 0) * 100, 0) AS overdue_ratio\n",
        "FROM dd CROSS JOIN p LEFT JOIN day x ON x.as_of_date = dd.as_of_date\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        },
        {
          "displayName": "Branch",
          "keyword": "branch",
          "dataType": "STRING",
          "defaultSelection": {
            "values": {
              "dataType": "STRING",
              "values": [
                {
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_monthly",
      "displayName": "Overdue Trend (Monthly)",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.card_mart_overdue_daily WHERE as_of_date <= :report_date) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.card_mart_overdue_daily WHERE :branch = 'all' OR mng_br = :branch),\n",
        "day AS (SELECT as_of_date, sum(ovd_bal) ovd, sum(port_bal) port FROM f GROUP BY as_of_date)\n",
        "\n",
        ", m AS (SELECT date_format(as_of_date, 'yyyy-MM') AS month, max(as_of_date) AS last_d\n",
        "        FROM gold.card_mart_overdue_daily, p WHERE as_of_date <= p.d\n",
        "          AND as_of_date > last_day(add_months(p.d, -6)) GROUP BY 1)\n",
        "\n",
        "SELECT m.month, coalesce(x.ovd, 0) / p.usd / 1000 AS overdue_k_usd,\n",
        "       coalesce(x.ovd / nullif(x.port, 0) * 100, 0) AS overdue_ratio\n",
        "FROM m CROSS JOIN p LEFT JOIN day x ON x.as_of_date = m.last_d\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
