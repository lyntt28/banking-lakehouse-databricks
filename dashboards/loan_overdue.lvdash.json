    {
      "name": "ovd_product_ratio",
      "displayName": "Overdue Ratio by Product Groups",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.loan_mart_overdue_daily WHERE :branch = 'all' OR branchnbr = :branch),\n",
        "day AS (SELECT as_of_date, sum(overdue_balance) ovd, sum(portfolio_balance) port\n",
        "        FROM f GROUP BY as_of_date)\n",
        "\n",
        "SELECT coalesce(f.product_group, 'Other') AS product_group,\n",
        "       sum(f.overdue_balance) / nullif(sum(f.portfolio_balance), 0) * 100 AS overdue_ratio\n",
        "FROM f, p WHERE f.as_of_date = p.d GROUP BY 1\n"
