    {
      "name": "ovd_product_amount",
      "displayName": "Overdue Amount by Product Groups",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.card_mart_overdue_daily WHERE as_of_date <= :report_date) AS d, (SELECT max_by(rate_to_vnd, rate_date) FROM silver.ref_fx_rates WHERE currencycd = 'USD' AND rate_date <= :report_date) AS usd),\n",
        "f AS (SELECT * FROM gold.card_mart_overdue_daily WHERE :branch = 'all' OR mng_br = :branch),\n",
        "day AS (SELECT as_of_date, sum(ovd_bal) ovd, sum(port_bal) port FROM f GROUP BY as_of_date)\n",
        "\n",
        "SELECT coalesce(f.product_group, 'Other') AS product_group,\n",
        "       sum(f.ovd_bal) / p.usd / 1000 AS overdue_k_usd\n",
        "FROM f, p WHERE f.as_of_date = p.d GROUP BY 1, p.usd\n"
