    {
      "name": "ovd_branch_top5",
      "displayName": "Overdue Ratio by Branches - Top5",
      "queryLines": [
        "WITH p AS (SELECT (SELECT max(as_of_date) FROM gold.loan_mart_overdue_daily WHERE as_of_date <= :report_date AND as_of_date <= (SELECT max(as_of_date) FROM ops.published_batches)) AS d),\n",
        "b AS (SELECT o.branchnbr, coalesce(db.br_name, o.branchnbr) AS branch,\n",
        "             sum(o.overdue_balance) / nullif(sum(o.portfolio_balance), 0) * 100 AS ratio\n",
        "      FROM gold.loan_mart_overdue_daily o CROSS JOIN p\n",
        "      LEFT JOIN gold.dim_branch db ON db.branchnbr = o.branchnbr\n",
        "      WHERE o.as_of_date = p.d GROUP BY 1, 2)\n",
        "SELECT concat('#', rn) AS rank, concat('#', rn, ' ', branch) AS branch, ratio\n",
        "FROM (SELECT *, row_number() OVER (ORDER BY ratio DESC) AS rn FROM b) WHERE rn <= 5\n"
      ],
      "parameters": [
        {
          "displayName": "Report date",
          "keyword": "report_date",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "now/d"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "ovd_branch_options",
      "displayName": "Branch options",
      "queryLines": [
